{
  "name": "@local/dsh-code-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "On-demand code review for DeepSeek Harness: audits the uncommitted changes in a workspace with a code-review specialist model and renders the report as a card in the conversation, for the human who asked for it.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "selftest.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
